{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mawofdespair": {
      "initial_state": "dormant",
      "states": {
        "dormant": {
          "animations": ["idle"],
          "transitions": [
            { "awake": "query.property('mawofdespair:awake')" },
            { "death": "!query.is_alive" }
          ]
        },
        "awake": {
          "animations": ["awake"],
          "transitions": [
            { "death": "!query.is_alive" }
          ]
        },
        "death": { "animations": ["death"] }
      }
    }
  }
}
